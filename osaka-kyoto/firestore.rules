rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedTrips/osaka-kyoto-2026 {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.keys().hasAll(['data', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.data.days is list
        && request.resource.data.data.days.size() == 8
        && request.resource.data.data.checklist is list;
      allow delete: if false;
    }
    // Photos for list items. Anyone with the link can add one; nobody can change or delete them.
    match /sharedTripImages/{imageId} {
      allow read: if true;
      allow create: if imageId.matches('img-[A-Za-z0-9-]{10,64}')
        && request.resource.data.keys().hasOnly(['trip', 'data', 'width', 'height', 'createdAt'])
        && request.resource.data.trip == 'osaka-kyoto-2026'
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.width is int
        && request.resource.data.height is int;
      allow update, delete: if false;
    }
    match /users/{userId}/trips/{tripId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

